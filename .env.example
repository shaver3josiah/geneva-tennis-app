# Copy to .env and fill in. Everything here is EXPO_PUBLIC_*, which Expo inlines into
# the JavaScript bundle at build time — so treat none of it as a secret. A Firebase web
# config is public by design; firebase/firestore.rules is what actually protects data.

# --- Option A: run against the local emulator (no cloud project needed) --------------
# npm run emulators   (in one terminal)
# npm run seed        (in another, once)
# npm start
# The seed makes a coach for you (coach@genevatennis.test) and the coach code GENEVA-DEMO.
EXPO_PUBLIC_USE_EMULATOR=1
# Only needed for a PHYSICAL device on the same wifi — put your machine's LAN IP here.
# The Android emulator uses 10.0.2.2 and the iOS simulator 127.0.0.1 automatically.
# EXPO_PUBLIC_EMULATOR_HOST=192.168.1.50

# --- Option B: run against the real Firebase project ---------------------------------
# Firebase console -> Project settings -> Your apps -> Web app -> SDK setup.
# Leave EXPO_PUBLIC_USE_EMULATOR unset (or 0) when using these.
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=

# --- The coach ------------------------------------------------------------------------
# What the screens call the coach: "Coach Smith", or just "Coach". Display only.
# EXPO_PUBLIC_COACH_NAME=Coach
#
# Who IS a coach is not set here. A coach signs up like anyone else, confirms their email,
# and on the "Nearly there" screen claims the role with the team's coach code. Set that code
# once per project (long and random; it is stored only as a SHA-256, in config/coachCode):
#   npm run set-coach-code -- "<the code>"
# See docs/START-HERE.md.

# --- Store release --------------------------------------------------------------------
# The privacy policy the You tab links to. Both stores require one; the link is hidden
# until this is set. Also set PRIVACY_POLICY_URL and SUPPORT_URL for the listing
# (docs/APP-STORE.md).
# EXPO_PUBLIC_PRIVACY_URL=

# ---------------------------------------------------------------------------
# The store-review demo account (scripts/review-account.mjs)
# ---------------------------------------------------------------------------
# The address and password Google Play and App Review sign in with. Set them here
# in your own .env, which is gitignored; the VALUES belong in
# docs/owner-open-items.md, which is not version controlled, because this
# repository is public and REVIEW_EMAIL is a real address the owner controls.
#
# The password is set BY the script, never typed into a signup form, because
# Play requires sign-in details "maintained at all times without any error" --
# a password someone rotates by hand is a rejection waiting to happen.
# REVIEW_EMAIL=
# REVIEW_PASSWORD=
#
# Optional. With these set the demo player also gets a player login, so a
# reviewer signed in as the guardian can see the monitored coach/player thread
# and the consent switch has something to govern. Without them the demo player
# is guardian-only, which is the under-13 model and still reviews fine.
# REVIEW_PLAYER_EMAIL=
# REVIEW_PLAYER_PASSWORD=
