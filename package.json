{
  "name": "geneva-tennis-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.9",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.9",
    "expo-mail-composer": "~57.0.2",
    "expo-notifications": "~57.0.19",
    "expo-router": "~57.0.19",
    "expo-screen-orientation": "~57.0.2",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.17.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "~19.2.2",
    "@types/react-dom": "^19.2.7",
    "firebase-tools": "^15.29.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test:rules": "firebase emulators:exec --project geneva-tennis-rules-test --only firestore --config firebase/firebase.json \"node --test firebase/test/rules.test.mjs\"",
    "emulators": "firebase emulators:start --project geneva-tennis-dev --config firebase/firebase.json",
    "typecheck": "tsc --noEmit",
    "contrast": "node scripts/contrast.mjs",
    "seed": "node scripts/seed.mjs",
    "set-coach-code": "node scripts/set-coach-code.mjs",
    "test:period": "node --experimental-strip-types scripts/check-period.mjs",
    "test:messages": "firebase emulators:exec --project geneva-tennis-messages-test --only firestore --config firebase/firebase.json \"node --test firebase/test/messages.test.mjs\"",
    "use-cloud": "node scripts/use-cloud.mjs",
    "web:coach": "expo start --web --port 8081",
    "web:player": "expo start --web --port 8082",
    "test:schedule": "node --experimental-strip-types scripts/check-schedule.mjs",
    "test:rewards": "node --experimental-strip-types scripts/check-rewards.mjs",
    "test:bridge": "node --experimental-strip-types scripts/check-bridge.mjs",
    "worksheets": "node scripts/build-worksheets.mjs",
    "sounds": "node scripts/build-sounds.mjs",
    "check:sounds": "node scripts/build-sounds.mjs --check",
    "check:worksheets": "node scripts/build-worksheets.mjs --check",
    "test:auth": "node --experimental-strip-types scripts/check-auth-messages.mjs",
    "check:keyboard": "node scripts/check-keyboard.mjs",
    "test:play": "node scripts/check-play.mjs",
    "screenshots": "node scripts/store-screenshots.mjs",
    "review:account": "node --env-file=.env scripts/review-account.mjs",
    "review:check": "node --env-file=.env scripts/review-account.mjs --check",
    "test:review": "node --test scripts/check-review-account.mjs",
    "appstore:metadata": "node --env-file=.env scripts/appstore-metadata.mjs",
    "appstore:dry": "node --env-file=.env scripts/appstore-metadata.mjs --dry",
    "test:appstore": "node --test scripts/check-appstore.mjs",
    "test:panel": "node --test scripts/check-release-panel.mjs",
    "test:tennis": "node --test scripts/check-tennis.mjs",
    "connector": "node scripts/build-connector.mjs",
    "release:panel": "node scripts/release-panel.mjs",
    "tracker": "node scripts/build-tracker.mjs && node scripts/build-worksheets.mjs",
    "check:tracker": "node scripts/build-tracker.mjs --check",
    "tracker:preview": "node scripts/build-tracker.mjs --preview",
    "brand": "node scripts/brand.mjs"
  },
  "private": true
}
